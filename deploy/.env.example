POSTGRES_PASSWORD=replace-with-a-long-random-password
# Required. age public recipient used by backup.sh; no plaintext dump is kept.
BACKUP_AGE_RECIPIENT=age1replace-with-your-public-recipient
BACKUP_RETENTION_DAYS=30
BACKUP_DIR=./backups
# Optional. Protects GET /metrics with the x-sync-metrics-token header.
SYNC_METRICS_TOKEN=replace-with-a-long-random-token
