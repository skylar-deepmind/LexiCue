{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "LexiCue Dictionary Result V1",
  "description": "Dictionary-only results. Metadata revision 1.2 retains explicit author_public_api source metadata for known public adapters 1.0.0/1.1.0; current query validators require 1.1.0 and reject unconfirmed mixed flat scope. Legacy rules remain. Structural validation must be followed by dictionary-result-standard-v1.txt. Metadata revision 1.3 adds separately validated Wiktionary / FreeDictionaryAPI source attribution and typed parent-sense scope, without changing legacy serialized snapshots. Metadata revision 1.4 adds a separate local Wiktionary v2 adapter with revision-pinned source metadata; online adapter semantic validation remains separate.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "query",
    "status",
    "default_entry_id",
    "entries",
    "notices"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "query": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "text",
        "language",
        "context"
      ],
      "properties": {
        "text": {
          "$ref": "#/$defs/text"
        },
        "language": {
          "const": "en"
        },
        "context": {
          "$ref": "#/$defs/nullableText",
          "description": "Original reading context, kept locally; never a dictionary example."
        }
      }
    },
    "status": {
      "enum": [
        "found",
        "partial",
        "not_found",
        "unavailable"
      ]
    },
    "default_entry_id": {
      "$ref": "#/$defs/nullableText"
    },
    "entries": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    },
    "notices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "code",
          "text",
          "entry_id"
        ],
        "properties": {
          "code": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "text": {
            "$ref": "#/$defs/text"
          },
          "entry_id": {
            "$ref": "#/$defs/nullableText"
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "found",
              "partial"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "entries": {
            "minItems": 1
          },
          "default_entry_id": {
            "$ref": "#/$defs/text"
          }
        }
      },
      "else": {
        "properties": {
          "entries": {
            "maxItems": 0
          },
          "default_entry_id": {
            "type": "null"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "enum": [
              "partial",
              "unavailable"
            ]
          }
        }
      },
      "then": {
        "properties": {
          "notices": {
            "minItems": 1
          }
        }
      }
    }
  ],
  "$defs": {
    "text": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "nullableText": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/text"
        }
      ]
    },
    "httpsUrl": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://[^\\s]+$"
    },
    "expressionType": {
      "enum": [
        null,
        "phrasal_verb",
        "idiom",
        "collocation",
        "fixed_expression"
      ]
    },
    "bilingualText": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "en",
        "zh"
      ],
      "properties": {
        "en": {
          "$ref": "#/$defs/nullableText"
        },
        "zh": {
          "$ref": "#/$defs/nullableText"
        }
      },
      "anyOf": [
        {
          "properties": {
            "en": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "properties": {
            "zh": {
              "$ref": "#/$defs/text"
            }
          }
        }
      ]
    },
    "audio": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "location"
      ],
      "properties": {
        "kind": {
          "enum": [
            "local_file",
            "remote_url"
          ]
        },
        "location": {
          "$ref": "#/$defs/text"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "remote_url"
              }
            }
          },
          "then": {
            "properties": {
              "location": {
                "$ref": "#/$defs/httpsUrl"
              }
            }
          }
        }
      ]
    },
    "nullableAudio": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/audio"
        }
      ]
    },
    "label": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "text"
      ],
      "properties": {
        "kind": {
          "enum": [
            "grammar",
            "register",
            "region",
            "level",
            "frequency",
            "source_tag",
            "source_topic",
            "source_label"
          ]
        },
        "text": {
          "$ref": "#/$defs/text"
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "english",
        "chinese",
        "audio"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "english": {
          "$ref": "#/$defs/text"
        },
        "chinese": {
          "$ref": "#/$defs/nullableText"
        },
        "audio": {
          "$ref": "#/$defs/nullableAudio"
        }
      }
    },
    "note": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "content",
        "examples"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "enum": [
            "grammar",
            "usage",
            "register",
            "region"
          ]
        },
        "content": {
          "$ref": "#/$defs/bilingualText"
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          }
        }
      }
    },
    "pattern": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "text",
        "explanation",
        "labels",
        "examples",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "text": {
          "$ref": "#/$defs/text"
        },
        "explanation": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/bilingualText"
            }
          ]
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/label"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          }
        }
      }
    },
    "sense": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "meaning",
        "labels",
        "patterns",
        "examples",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "meaning": {
          "$ref": "#/$defs/bilingualText"
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/label"
          }
        },
        "patterns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pattern"
          }
        },
        "examples": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          }
        },
        "source_path": {
          "type": "string",
          "pattern": "^(?:/entries/[0-9]+/senses/[0-9]+(?:/subsenses/[0-9]+)*|/records/[1-9][0-9]*/senses/[0-9]+)$"
        },
        "content_kind": {
          "enum": [
            "definition",
            "relation"
          ]
        },
        "ancestors": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "$ref": "#/$defs/senseAncestor"
          }
        }
      }
    },
    "pronunciation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "region",
        "ipa",
        "audio",
        "form_label"
      ],
      "properties": {
        "region": {
          "enum": [
            "uk",
            "us",
            "unspecified"
          ]
        },
        "ipa": {
          "$ref": "#/$defs/nullableText"
        },
        "audio": {
          "$ref": "#/$defs/nullableAudio"
        },
        "form_label": {
          "$ref": "#/$defs/nullableText"
        }
      },
      "anyOf": [
        {
          "properties": {
            "ipa": {
              "$ref": "#/$defs/text"
            }
          }
        },
        {
          "properties": {
            "audio": {
              "$ref": "#/$defs/audio"
            }
          }
        }
      ]
    },
    "group": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "part_of_speech",
        "source_part_of_speech",
        "pronunciations",
        "forms",
        "labels",
        "senses",
        "notes"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "part_of_speech": {
          "enum": [
            null,
            "noun",
            "verb",
            "adjective",
            "adverb",
            "pronoun",
            "determiner",
            "preposition",
            "conjunction",
            "interjection",
            "auxiliary",
            "modal",
            "numeral",
            "particle",
            "prefix",
            "suffix",
            "abbreviation",
            "symbol",
            "other"
          ]
        },
        "source_part_of_speech": {
          "$ref": "#/$defs/nullableText"
        },
        "pronunciations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/pronunciation"
          }
        },
        "forms": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "label"
            ],
            "properties": {
              "text": {
                "$ref": "#/$defs/text"
              },
              "label": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/label"
          }
        },
        "senses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/sense"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          }
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "dataset",
        "edition",
        "release",
        "adapter_version",
        "delivery",
        "entry_key",
        "locator",
        "entry_url",
        "retrieved_at"
      ],
      "properties": {
        "provider": {
          "enum": [
            "longman",
            "cambridge",
            "wiktionary"
          ]
        },
        "dataset": {
          "$ref": "#/$defs/text"
        },
        "edition": {
          "$ref": "#/$defs/nullableText"
        },
        "release": {
          "$ref": "#/$defs/nullableText"
        },
        "adapter_version": {
          "$ref": "#/$defs/text"
        },
        "delivery": {
          "enum": [
            "local",
            "online",
            "cache"
          ]
        },
        "entry_key": {
          "$ref": "#/$defs/text"
        },
        "locator": {
          "$ref": "#/$defs/nullableText"
        },
        "entry_url": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/httpsUrl"
            }
          ]
        },
        "retrieved_at": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "format": "date-time"
            }
          ]
        },
        "access_channel": {
          "enum": [
            "author_public_api",
            "freedictionaryapi"
          ]
        },
        "service_url": {
          "enum": [
            "https://dictionary-api.eliaschen.dev",
            "https://freedictionaryapi.com"
          ]
        },
        "received_at": {
          "type": "string",
          "format": "date-time"
        },
        "content_hash": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "license": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "name",
            "url"
          ],
          "properties": {
            "name": {
              "const": "CC BY-SA 4.0"
            },
            "url": {
              "const": "https://creativecommons.org/licenses/by-sa/4.0/"
            }
          }
        },
        "attribution": {
          "enum": [
            "Wiktionary contributors via FreeDictionaryAPI.com",
            "English Wiktionary contributors"
          ]
        },
        "modifications": {
          "enum": [
            "Adapted English definitions and ordinary examples; translations, quotations and audio omitted.",
            "Selected English senses, verified ordinary examples and source metadata; compacted and split into coverage packs. Translations, quotations and audio omitted."
          ]
        },
        "source_revision": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        },
        "source_page": {
          "type": "string",
          "pattern": "^[1-9][0-9]*$"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "provider": {
                "const": "longman"
              }
            }
          },
          "then": {
            "properties": {
              "release": {
                "$ref": "#/$defs/text"
              }
            }
          }
        },
        {
          "if": {
            "allOf": [
              {
                "properties": {
                  "provider": {
                    "enum": [
                      "longman",
                      "cambridge"
                    ]
                  }
                }
              },
              {
                "anyOf": [
                  {
                    "required": [
                      "access_channel"
                    ]
                  },
                  {
                    "required": [
                      "service_url"
                    ]
                  },
                  {
                    "required": [
                      "received_at"
                    ]
                  },
                  {
                    "required": [
                      "adapter_version"
                    ],
                    "properties": {
                      "adapter_version": {
                        "enum": [
                          "cambridge-public-v1.0.0",
                          "cambridge-public-v1.1.0"
                        ]
                      }
                    }
                  }
                ]
              }
            ]
          },
          "then": {
            "required": [
              "access_channel",
              "service_url",
              "received_at"
            ],
            "properties": {
              "provider": {
                "const": "cambridge"
              },
              "dataset": {
                "const": "Cambridge Dictionary (author public API)"
              },
              "adapter_version": {
                "enum": [
                  "cambridge-public-v1.0.0",
                  "cambridge-public-v1.1.0"
                ]
              },
              "delivery": {
                "enum": [
                  "online",
                  "cache"
                ]
              },
              "edition": {
                "type": "null"
              },
              "release": {
                "type": "null"
              },
              "entry_url": {
                "type": "null"
              },
              "retrieved_at": {
                "type": "null"
              },
              "access_channel": {
                "const": "author_public_api"
              },
              "service_url": {
                "const": "https://dictionary-api.eliaschen.dev"
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "provider": {
                  "const": "cambridge"
                }
              }
            },
            "then": {
              "properties": {
                "entry_url": {
                  "$ref": "#/$defs/httpsUrl"
                },
                "retrieved_at": {
                  "type": "string",
                  "format": "date-time"
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "wiktionary"
              },
              "adapter_version": {
                "not": {
                  "const": "wiktionary-local-v2.0.0"
                }
              }
            }
          },
          "then": {
            "required": [
              "access_channel",
              "service_url",
              "received_at",
              "content_hash",
              "license",
              "attribution",
              "modifications"
            ],
            "properties": {
              "dataset": {
                "const": "Wiktionary"
              },
              "adapter_version": {
                "const": "freedictionaryapi-v1.0.0"
              },
              "access_channel": {
                "const": "freedictionaryapi"
              },
              "service_url": {
                "const": "https://freedictionaryapi.com"
              },
              "delivery": {
                "enum": [
                  "online",
                  "cache"
                ]
              },
              "edition": {
                "type": "null"
              },
              "release": {
                "type": "null"
              },
              "entry_url": {
                "$ref": "#/$defs/httpsUrl"
              },
              "retrieved_at": {
                "type": "string",
                "format": "date-time"
              },
              "locator": {
                "$ref": "#/$defs/text"
              }
            }
          },
          "else": {
            "if": {
              "properties": {
                "provider": {
                  "not": {
                    "const": "wiktionary"
                  }
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "content_hash"
                    ]
                  },
                  {
                    "required": [
                      "license"
                    ]
                  },
                  {
                    "required": [
                      "attribution"
                    ]
                  },
                  {
                    "required": [
                      "modifications"
                    ]
                  }
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "provider": {
                "const": "wiktionary"
              },
              "adapter_version": {
                "const": "wiktionary-local-v2.0.0"
              }
            },
            "required": [
              "provider",
              "adapter_version"
            ]
          },
          "then": {
            "required": [
              "content_hash",
              "source_revision",
              "source_page",
              "license",
              "attribution",
              "modifications"
            ],
            "properties": {
              "dataset": {
                "const": "English Wiktionary"
              },
              "release": {
                "const": "enwiktionary-20261001-lexicue-v2"
              },
              "edition": {
                "type": "null"
              },
              "retrieved_at": {
                "type": "null"
              },
              "delivery": {
                "const": "local"
              },
              "locator": {
                "type": "string",
                "pattern": "^/records/[1-9][0-9]*$"
              },
              "entry_key": {
                "type": "string",
                "pattern": "^wiktionary:enwiktionary-20261001-lexicue-v2:r[1-9][0-9]*$"
              },
              "entry_url": {
                "$ref": "#/$defs/httpsUrl"
              },
              "attribution": {
                "const": "English Wiktionary contributors"
              }
            },
            "not": {
              "anyOf": [
                {
                  "required": [
                    "access_channel"
                  ]
                },
                {
                  "required": [
                    "service_url"
                  ]
                },
                {
                  "required": [
                    "received_at"
                  ]
                }
              ]
            }
          }
        },
        {
          "if": {
            "not": {
              "properties": {
                "provider": {
                  "const": "wiktionary"
                },
                "adapter_version": {
                  "const": "wiktionary-local-v2.0.0"
                }
              },
              "required": [
                "provider",
                "adapter_version"
              ]
            }
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "source_revision"
                  ]
                },
                {
                  "required": [
                    "source_page"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "match": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "pattern",
        "note",
        "sense_ids"
      ],
      "properties": {
        "type": {
          "enum": [
            "exact",
            "inflection",
            "spelling_variant",
            "expression_pattern",
            "reference",
            "source_relation",
            "casefold_candidate"
          ]
        },
        "pattern": {
          "$ref": "#/$defs/nullableText"
        },
        "note": {
          "$ref": "#/$defs/nullableText"
        },
        "sense_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/text"
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "expression_pattern"
              }
            }
          },
          "then": {
            "properties": {
              "pattern": {
                "$ref": "#/$defs/text"
              },
              "sense_ids": {
                "minItems": 1
              }
            }
          }
        }
      ]
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "headword",
        "kind",
        "expression_type",
        "origin",
        "parent_headword",
        "source",
        "match",
        "groups",
        "notes",
        "related_expressions"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/text"
        },
        "headword": {
          "$ref": "#/$defs/text"
        },
        "kind": {
          "enum": [
            "word",
            "expression"
          ]
        },
        "expression_type": {
          "$ref": "#/$defs/expressionType"
        },
        "origin": {
          "enum": [
            "headword",
            "subentry",
            "construction",
            "note"
          ]
        },
        "parent_headword": {
          "$ref": "#/$defs/nullableText"
        },
        "source": {
          "$ref": "#/$defs/source"
        },
        "match": {
          "$ref": "#/$defs/match"
        },
        "groups": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/group"
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/note"
          }
        },
        "related_expressions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "text",
              "expression_type",
              "scope_id",
              "target_query"
            ],
            "properties": {
              "text": {
                "$ref": "#/$defs/text"
              },
              "expression_type": {
                "$ref": "#/$defs/expressionType"
              },
              "scope_id": {
                "$ref": "#/$defs/text",
                "description": "Containing entry, group or sense ID."
              },
              "target_query": {
                "$ref": "#/$defs/text"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "word"
              }
            }
          },
          "then": {
            "properties": {
              "expression_type": {
                "type": "null"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "origin": {
                "enum": [
                  "subentry",
                  "construction",
                  "note"
                ]
              }
            }
          },
          "then": {
            "properties": {
              "parent_headword": {
                "$ref": "#/$defs/text"
              },
              "source": {
                "properties": {
                  "locator": {
                    "$ref": "#/$defs/text"
                  }
                }
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "source": {
                "properties": {
                  "provider": {
                    "const": "wiktionary"
                  }
                }
              }
            }
          },
          "then": {
            "properties": {
              "groups": {
                "items": {
                  "properties": {
                    "senses": {
                      "items": {
                        "required": [
                          "source_path",
                          "content_kind",
                          "ancestors"
                        ],
                        "properties": {
                          "meaning": {
                            "properties": {
                              "zh": {
                                "type": "null"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      ]
    },
    "senseAncestor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "meaning",
        "labels"
      ],
      "properties": {
        "source_path": {
          "type": "string",
          "pattern": "^(?:/entries/[0-9]+/senses/[0-9]+(?:/subsenses/[0-9]+)*|/records/[1-9][0-9]*/senses/[0-9]+/ancestors/[0-9]+)$"
        },
        "meaning": {
          "$ref": "#/$defs/bilingualText"
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/label"
          }
        }
      }
    }
  }
}
