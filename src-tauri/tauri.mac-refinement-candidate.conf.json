{
  "productName": "LexiCue Refined Candidate",
  "identifier": "com.lexicue.mac-refinement-candidate",
  "build": {
    "devUrl": "http://127.0.0.1:5198",
    "beforeDevCommand": "",
    "beforeBuildCommand": "npm run prepare:gemma && npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "LexiCue · 修订体验",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "capabilities": [
        "default"
      ]
    }
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "targets": [
      "app",
      "dmg"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
