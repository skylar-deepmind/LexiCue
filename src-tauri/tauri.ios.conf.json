{
  "identifier": "com.skylar.lexicue.ios",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 0.0.0.0",
    "beforeBuildCommand": "npm run build"
  },
  "bundle": {
    "createUpdaterArtifacts": false,
    "resources": [
      "resources/ENGLISH-LICENSE.txt",
      "resources/TTS-LICENSE.txt",
      "resources/DOCUMENT-IMPORT-LICENSES.txt",
      "resources/dictionaries/catalog.json",
      "resources/dictionaries/daily/"
    ],
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
